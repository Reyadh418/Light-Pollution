# LaTeX build artifacts (ignore auxiliary build outputs across all subdirectories)
**/*.aux
**/*.bbl
**/*.blg
**/*.fls
**/*.fdb_latexmk
**/*.log
**/*.out
**/*.synctex.gz
**/*.toc
**/*.nav
**/*.snm
**/*.vrb

# Python cache and environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Operating system metadata
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Office and editor temporary lock files
~$*.xlsx
~$*.docx
~$*.pptx
*.swp
*.swo
*~